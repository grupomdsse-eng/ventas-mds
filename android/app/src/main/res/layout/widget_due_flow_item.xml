<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_due_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="7dp">
    <TextView
        android:id="@+id/widget_due_item_stage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_due_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#102B4B"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_due_item_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#526D85"
        android:textSize="10sp" />
</LinearLayout>
