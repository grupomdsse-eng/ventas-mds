<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FBFD"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat directo"
            android:textColor="@color/widget_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/chat_widget_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Cerrar"
            android:text="×"
            android:textSize="28sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/chat_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/chat_widget_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reintentar"
        android:visibility="gone" />

    <ListView
        android:id="@+id/chat_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="#FFD7E3EC"
        android:dividerHeight="1dp" />
</LinearLayout>
