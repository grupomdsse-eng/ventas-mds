<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_due_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_board_background"
    android:orientation="vertical"
    android:padding="9dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TABLÓN · PRÓXIMOS FLUJOS"
            android:textColor="#073D6D"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_due_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_count_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="Consultando"
            android:textColor="#0074C7"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_due_refresh"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#0074C7"
            android:textSize="19sp" />
    </LinearLayout>
    <ListView
        android:id="@+id/widget_due_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@null"
        android:scrollbars="vertical" />
    <TextView
        android:id="@+id/widget_due_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Actualizando flujos…"
        android:textAlignment="center"
        android:textColor="#59738D"
        android:textSize="12sp" />
</LinearLayout>
