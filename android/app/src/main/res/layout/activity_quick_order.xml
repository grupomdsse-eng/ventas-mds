<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FBFD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nuevo pedido"
                android:textColor="@color/widget_ink"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/quick_order_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Crea un pedido completo sin abrir la aplicación."
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Empresa"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/quick_order_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Cliente"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
        <AutoCompleteTextView
            android:id="@+id/quick_order_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:hint="Escribe para buscar un cliente"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:id="@+id/quick_order_preparer_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Encargado de tramitar"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/quick_order_preparer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Notas"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/quick_order_notes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|start"
            android:hint="Información necesaria para preparar el pedido"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="5000"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Foto, documento o audio"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/quick_order_camera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/mds_blue"
                android:text="Abrir cámara"
                android:textColor="#FFFFFFFF" />
            <Button
                android:id="@+id/quick_order_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Subir archivo" />
        </LinearLayout>
        <Button
            android:id="@+id/quick_order_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Grabar audio" />
        <ImageView
            android:id="@+id/quick_order_photo_preview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Vista previa de la foto del pedido"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/quick_order_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/quick_order_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
        <Button
            android:id="@+id/quick_order_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/mds_blue"
            android:enabled="false"
            android:text="Crear pedido"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</ScrollView>
